    {
      "id": "update-transition",
      "command": "node",
      "args": ["tests/e2e-update.mjs"],
      "env": {
        "AUTO_AGREE_PREVIOUS_REF": "${BASE}"
      }
    },
    {
      "id": "paired-performance",
      "command": "node",
      "args": [
        "tests/e2e-performance-paired.mjs",
        "--base",
        "${BASE}",
        "--candidate",
        "${HEAD}",
        "--repetitions",
        "5"
      ]
    }
