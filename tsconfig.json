{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["chrome"],
    "skipLibCheck": true,
    "strict": false,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false
  },
  "include": [
    "extension/**/*.js",
    "types/**/*.d.ts"
  ]
}
