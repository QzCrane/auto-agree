{
  "name": "auto-agree",
  "version": "12.2.0",
  "private": true,
  "type": "module",
  "description": "Evidence-gated Chrome extension that automatically accepts routine mandatory access agreements while refusing consequential consent.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "check": "node tests/run-core.mjs && npm run typecheck",
    "test": "npm run check",
    "e2e": "node tests/e2e-extension.mjs",
    "profile:e2e": "node tests/e2e-extension.mjs --profile",
    "performance:paired": "node tests/e2e-performance-paired.mjs",
    "closeout:evidence": "node tools/closeout-evidence.mjs record",
    "closeout:verify": "node tools/closeout-evidence.mjs verify",
    "closeout:merge": "node tools/closeout-evidence.mjs merge"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/chrome": "0.2.2",
    "@types/node": "24.13.3",
    "fast-check": "4.9.0",
    "puppeteer": "25.1.0",
    "typescript": "7.0.2"
  }
}
